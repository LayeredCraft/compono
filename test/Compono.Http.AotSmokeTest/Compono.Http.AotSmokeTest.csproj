<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0051/PLAN-0051 Task 5, Proof B: a real Native AOT publish-and-run proof through the
       actual packaged Compono.Http dependency chain - a single throwaway console app that
       configures a TestHttpHandler, sends a real HttpClient request through it, and verifies the
       response, using ONLY the RespondJson(value, JsonTypeInfo<T>) overload (the intended AOT-safe
       path). Does NOT exercise RespondJson(value, JsonSerializerOptions?) here - that overload's
       correct behavior is advertising the framework's real RequiresDynamicCode/
       RequiresUnreferencedCode constraint, not publishing warning-free under PublishAot (see
       Task 5's own "two separate proofs, not one" split - the analyzer-contract proof in
       AnalyzerContract/ is Proof A, this project is Proof B). Mirrors
       test/Compono.TestDoubles.AotSmokeTest's own .csproj almost verbatim - see that project's
       comments for the full reasoning behind each choice below. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Overrides test/Directory.Build.props' multi-TFM sweep (net8.0;net9.0;net10.0;net11.0) - this
         is a one-shot AOT publish-and-run proof, not a matrix run; a single current TFM is enough. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The repo's central Directory.Packages.props doesn't (and shouldn't) know about the
         throwaway "1.0.0" version pack-compono.sh stamps onto its local-feed-only nupkgs - opting
         this one project out of CPM instead of adding a fake pin to the shared file. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Isolates this restore from NuGet's shared global packages folder entirely - NuGet treats a
         package id+version already present in a packages folder as immutable and never re-extracts
         it, so rerunning pack-compono.sh with different source under the same fixed "1.0.0" version
         would otherwise let a stale global-cache entry silently satisfy a later restore/publish,
         printing PASS without ever exercising the current handler/matching/dispatch code. Mirrors
         Compono.TestDoubles.AotSmokeTest's own RestorePackagesPath isolation - no per-run GUID
         scoping needed there, since this harness is a manual one-shot, never run concurrently with
         itself. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/.nuget-packages/</RestorePackagesPath>
  </PropertyGroup>

  <!-- test/Directory.Build.props' global usings assume every project under test/ references
       Xunit/NSubstitute/AwesomeAssertions (true for every other project here, all real test
       projects) - this one deliberately doesn't, so those usings would fail to compile. -->
  <ItemGroup>
    <Using Remove="Xunit" />
    <Using Remove="NSubstitute" />
    <Using Remove="AwesomeAssertions" />
  </ItemGroup>

  <!-- A PackageReference, not a ProjectReference to src/Compono.Http/Compono.Http.csproj - the
       same consumption shape any real consumer uses, and required here specifically: a
       ProjectReference's global properties (PublishAot/RuntimeIdentifier/SelfContained) flow down
       into Compono.csproj's own analyzer-only ProjectReference to Compono.Generators.csproj
       (netstandard2.0), failing `dotnet publish -p:PublishAot=true` with NETSDK1207 ("AOT is not
       supported for the target framework") for a project that's never actually part of the
       published app. A PackageReference has no such project-graph propagation - the generator
       analyzer just rides along as a plain `analyzers/dotnet/cs` asset inside Compono's packed
       .nupkg, exactly like a real consumer gets it. Packed into
       ../../.local-nuget-feed-http-aot-smoke by pack-compono.sh (run before publish, not an
       MSBuild pre-restore target - this project's publish is a deliberate, manual, one-shot proof,
       not part of the ordinary inner-loop restore). -->
  <ItemGroup>
    <PackageReference Include="Compono.Http" Version="1.0.0" />
  </ItemGroup>

  <!-- AnalyzerContract/ holds two SEPARATE, sibling .csproj files (Proof A - see that folder's own
       verify-analyzer-contract.sh) nested under this project's own directory. SDK-style projects
       implicitly glob every *.cs file under their own directory tree by default, which would
       otherwise pull AnalyzerContract's Program.cs files (and even their own obj/-generated
       AssemblyInfo.cs) into THIS project's compilation too, producing duplicate-attribute build
       errors (CS0579) the moment either sub-project has been built at least once. Excluded
       explicitly rather than restructuring the folder layout, since AnalyzerContract/ is
       conceptually "this proof's sibling proof," not unrelated content that belongs elsewhere. -->
  <ItemGroup>
    <Compile Remove="AnalyzerContract/**/*.cs" />
  </ItemGroup>

</Project>
