<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Compono.Generators.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft Testing Platform (MTP) runner, not VSTest -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Overrides test/Directory.Build.props' net8.0;net9.0;net10.0;net11.0 (ADR-0038) - this
         project tests Compono.Generators (netstandard2.0, unaffected by ADR-0038) by driving
         CSharpGeneratorDriver directly against Basic.Reference.Assemblies.NetXXX reference-assembly
         sets below, which only exist for net10.0/net11.0 in this repo's dependencies. Widening this
         project's own host TFM to net8.0/net9.0 would test nothing new (the generator itself never
         varies by consumer TFM) and has no matching reference-assembly package to compile against. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Basic.Reference.Assemblies.Net110" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced normally (not analyzer-only) - the test drives the generator directly via
         CSharpGeneratorDriver, not via an analyzer/build reference. -->
    <ProjectReference Include="..\..\src\Compono.Generators\Compono.Generators.csproj" />
    <!-- The test's inline source compiles against Compono.Composer/ICompositionPlan<T>/PlanCache<T>. -->
    <ProjectReference Include="..\..\src\Compono\Compono.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Snapshots\" />
  </ItemGroup>

</Project>
