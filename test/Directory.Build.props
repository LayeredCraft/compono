<Project>
  <!-- A nested Directory.Build.props doesn't automatically chain to the
       repo-root one - MSBuild imports only the nearest one found walking
       up from the project directory. Import the root one explicitly so
       every setting there (package metadata, DebugType, the IsTestProject
       IsPackable rule, SourceLink) still applies to everything under test/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Run every test project against every TFM Compono itself ships
         (src/Compono/Compono.csproj's TargetFrameworks) - a test suite that
         only exercises net11.0 gives zero coverage of the net10.0 build.
         ADR-0038 widened Compono's own TargetFrameworks to net8.0;net9.0 -
         widened here too, so this comment's stated intent stays true and
         Compono.XunitV3.SampleTests' packed-consumer smoke test (which has
         no TargetFrameworks of its own, inheriting this value) actually
         exercises the net8.0/net9.0 packed assets, not just net10.0/net11.0. -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- Which test framework a given test project runs under - "XunitV3" (the default every
         existing test project gets for free) or "TUnit" (set explicitly, in that project's own
         PropertyGroup, by Compono.TUnit.Tests/Compono.TUnit.SampleTests). test/Directory.Build.targets
         gates the xUnit-v3-only Using/PackageReference ItemGroups on this property rather than
         matching the project's name - a project-name string match breaks the moment a project is
         renamed and gives no compile-time signal that a new TUnit-run project forgot to opt out; a
         property a project declares about itself is the property's whole point. Set here (in
         Directory.Build.props, imported *before* the project body) only as the fallback default - a
         TUnit project's own override in its own PropertyGroup (evaluated as part of the project body,
         after this import) still wins for that property's own later reads, per ordinary MSBuild
         document-order property evaluation; what actually *depends* on this property's final value
         must live in Directory.Build.targets (imported *after* the project body), not here, or it
         would see this default, not the override - see that file's own comment. -->
    <ComponoTestFramework Condition="'$(ComponoTestFramework)' == ''">XunitV3</ComponoTestFramework>
  </PropertyGroup>
</Project>
