<Project>
  <!-- A nested Directory.Build.props doesn't automatically chain to the
       repo-root one - MSBuild imports only the nearest one found walking
       up from the project directory. Import the root one explicitly so
       every setting there (package metadata, DebugType, the IsTestProject
       IsPackable rule, SourceLink) still applies to everything under test/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Run every test project against every TFM Compono itself ships
         (src/Compono/Compono.csproj's TargetFrameworks) - a test suite that
         only exercises net11.0 gives zero coverage of the net10.0 build.
         ADR-0038 widened Compono's own TargetFrameworks to net8.0;net9.0 -
         widened here too, so this comment's stated intent stays true and
         Compono.XunitV3.SampleTests' packed-consumer smoke test (which has
         no TargetFrameworks of its own, inheriting this value) actually
         exercises the net8.0/net9.0 packed assets, not just net10.0/net11.0. -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <!-- Common test-project package references, so individual test .csproj
       files only need to declare what's actually specific to them (a
       project reference, a project-specific package). Scoped to
       IsTestProject rather than unconditional, matching AlexaVoxCraft's
       test/Directory.Build.props paradigm - a future non-test helper
       project under test/ (a shared TestKit, if this repo grows enough
       test projects to warrant one) wouldn't want these forced on it. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
