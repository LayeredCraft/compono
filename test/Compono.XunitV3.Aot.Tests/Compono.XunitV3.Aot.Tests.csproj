<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Compono.XunitV3.Aot.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Opts this project out of test/Directory.Build.targets' xUnit-v3-reflection-mode-only
         ItemGroups (Using Xunit/NSubstitute/AwesomeAssertions, the xunit.v3.mtp-v2 PackageReference)
         - a property this project declares about itself, matching Compono.TUnit.Tests'/
         Compono.MSTest.Tests'/Compono.NUnit.Tests' identical precedent
         (test/Directory.Build.targets' conditions were extended to also check for 'XunitV3Aot' as
         part of this package's own implementation). Never references the reflection-mode
         xunit.v3.mtp-v2/xunit.v3.extensibility.core packages at all - see the PackageReference
         below and ADR-0066 for why that's the whole point. -->
    <ComponoTestFramework>XunitV3Aot</ComponoTestFramework>
    <!-- net9.0+ only, matching Compono.XunitV3.Aot's own floor (ADR-0066/RESEARCH-0032) - there is
         no net8.0 xUnit v3 Native AOT package to test against. -->
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- PLAN-0071 B5.11 / S5: prove the "plain [Obsolete] member under TreatWarningsAsErrors" case.
         The generated [ComposeData] registration reads the member through generated code whose header
         carries `#pragma warning disable CS0612, CS0618` (AotComposeDataRegistration.scriban), so
         raising obsolete-usage warnings to errors here fails the build if that suppression ever
         regresses - while leaving every other warning classification untouched (this project is
         warning-clean, so a full TreatWarningsAsErrors is unnecessary and would couple the suite to
         unrelated analyzer output). See ADR-0070 Amendment 4 (2c) / ADR-0066. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0612;CS0618</WarningsAsErrors>
    <!-- PLAN-0071 S7 Native AOT opt-in, authorized by PLAN-0071's 2026-11-09 S7 infrastructure
         decision. ADR-0041 Amendment 5 and PLAN-0041's "AOT harness packaging note" establish the
         separate package-based consumer-validation policy; they do not authorize this internal
         project-scoped mechanism. This project must NOT be published by passing a
         global `-p:PublishAot=true`: MSBuild treats `-p:` properties as globals and forwards them to
         every project in the reference graph - including during restore. That reaches the
         netstandard2.0 `Compono.Generators` project through two analyzer ProjectReference paths (this
         project's own OutputItemType="Analyzer" reference, and transitively via Compono.XunitV3.Aot ->
         Compono -> Compono.csproj's analyzer-only reference), producing
         `NETSDK1207: Ahead-of-time compilation is not supported for the target framework`. Setting
         PublishAot here makes it a project-local property instead, so it never propagates to either
         analyzer reference; the opt-in property itself propagates harmlessly. This is the same
         propagation PLAN-0041 recorded for `Compono.AotSmokeTest`, but resolved without changing the
         shipped analyzer-reference shape. Publish with
         `-p:ComponoAotTestsPublish=true` instead of `-p:PublishAot=true`. This internal-suite mechanism
         is distinct from the package-based policy in ADR-0041 Amendment 5 / PLAN-0041 (local-feed
         PackageReference) - it does not prove packaging. -->
    <PublishAot Condition="'$(ComponoAotTestsPublish)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup Condition="'$(ComponoAotTestsPublish)' == 'true'">
    <!-- Enumerating every type in the assembly (Assembly.GetTypes) is inherently trimming-incompatible:
         the trimmer removes unused public types, so this test reports IL2026 and fails under Native AOT.
         Exclude it ONLY for the S7 Native AOT publish; it stays compiled and executed in every ordinary
         build and `dotnet test` run, where it still guards the public API surface. -->
    <Compile Remove="PublicApiSurfaceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Compono.XunitV3.Aot\Compono.XunitV3.Aot.csproj" />
    <!-- A plain ProjectReference to Compono.csproj (transitively, via Compono.XunitV3.Aot) does not
         propagate Compono.Generators.dll as an active analyzer - this project's own [Compose]-
         attributed test methods need real AotTheoryDataRowRegistration/PlanCache/RowInvokerRegistry
         registrations for their parameter types, matching Compono.XunitV3.Tests'/
         Compono.TUnit.Tests'/Compono.MSTest.Tests'/Compono.NUnit.Tests' identical precedent. -->
    <ProjectReference Include="..\..\src\Compono.Generators\Compono.Generators.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
