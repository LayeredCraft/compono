<Project Sdk="Microsoft.NET.Sdk">

  <!-- PLAN-0055 task 15, mirroring Compono.Http.AotSmokeTest/Compono.TestDoubles.AotSmokeTest's own
       shape almost verbatim (see those projects' comments for the fuller reasoning behind each
       choice below): a real Native AOT publish-and-run proof through the actual packaged
       Compono/Compono.Logging dependency chain - composing a real ILogger<T> constructor
       dependency via UseLogging(), through the shared Compono.Generators-emitted activation (not
       direct construction alone), then verifying capture/Verify() work post-publish. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Overrides test/Directory.Build.props' multi-TFM sweep - this is a one-shot AOT
         publish-and-run proof, not a matrix run; a single current TFM is enough. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The repo's central Directory.Packages.props doesn't (and shouldn't) know about the
         throwaway "1.0.0" version pack-compono.sh stamps onto its local-feed-only nupkgs. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Isolates this restore from NuGet's shared global packages folder entirely - see
         Compono.Http.AotSmokeTest's own identical comment for why this matters across reruns. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/.nuget-packages/</RestorePackagesPath>
  </PropertyGroup>

  <!-- test/Directory.Build.props' global usings assume every project under test/ references
       Xunit/NSubstitute/AwesomeAssertions - this one deliberately doesn't. -->
  <ItemGroup>
    <Using Remove="Xunit" />
    <Using Remove="NSubstitute" />
    <Using Remove="AwesomeAssertions" />
  </ItemGroup>

  <!-- PackageReferences, not ProjectReferences to src/Compono*/*.csproj - the same consumption
       shape any real consumer uses, and required here specifically: a ProjectReference's global
       properties (PublishAot/RuntimeIdentifier/SelfContained) flow down into Compono.csproj's own
       analyzer-only ProjectReference to Compono.Generators.csproj (netstandard2.0), failing
       `dotnet publish -p:PublishAot=true` with NETSDK1207 for a project never actually part of the
       published app. A PackageReference has no such project-graph propagation - the generator
       analyzer just rides along as a plain analyzers/dotnet/cs asset inside Compono's packed
       .nupkg, and ComponoGeneratedLogging's default-true value rides along via Compono.Logging's
       own packed build/buildTransitive props asset, exactly like a real consumer gets both.
       Packed into ../../.local-nuget-feed-logging-aot-smoke by pack-compono.sh (run before
       publish, a deliberate manual one-shot proof, not part of ordinary inner-loop restore). -->
  <ItemGroup>
    <PackageReference Include="Compono.Logging" Version="1.0.0" />
  </ItemGroup>

</Project>
