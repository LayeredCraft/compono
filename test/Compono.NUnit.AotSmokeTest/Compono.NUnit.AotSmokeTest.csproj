<Project Sdk="Microsoft.NET.Sdk">

  <!-- PLAN-0059 task group 10's own real Native AOT publish-and-run proof, through the actual
       packaged Compono.NUnit dependency chain (not just the shared RowInvokerRegistry mechanism in
       isolation - test/Compono.AotSmokeTest already proved that generically for PLAN-0041). A
       single throwaway console app that drives the real, packaged Compono.NUnit.ComposeAttribute
       .BuildFrom(IMethodInfo, Test?) directly - unlike Compono.MSTest's own AOT smoke test, this one
       needs a real NUnit.Framework.Internal.MethodWrapper to construct the IMethodInfo BuildFrom
       expects, not a plain MethodInfo (ADR-0059 §4/§9's own genuine surface difference).
       `dotnet publish -c Release -p:PublishAot=true` + run is this project's whole purpose, not
       incremental inner-loop iteration. Mirrors test/Compono.MSTest.AotSmokeTest's own .csproj
       almost verbatim - see that project's comments for the full reasoning behind each choice
       below.

       Boundary this project proves and does NOT overclaim (ADR-0059 §17): this is proof that
       Compono.NUnit's own shipped integration code (BindingPlan.Build, Compono.NUnit.Binding
       .RowInvokers.Build, ConfigProfileBinder's ConstructorInfo.Invoke-based TConfig/TProfile
       construction) survives Native AOT with no reflection-based generic dispatch. It is
       deliberately NOT a proof that NUnit's own test runner/adapter chain (NUnit3TestAdapter, the
       classic VSTest host, or the MTP host) can itself execute a published Native AOT test
       assembly - no evidence for that claim was found during ADR-0059's own research (RESEARCH-0018
       §10), and this project does not attempt to manufacture any. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- test/Directory.Build.targets gates the xUnit-v3-only Using/PackageReference ItemGroups
         (Xunit/NSubstitute/AwesomeAssertions/Microsoft.Testing.Platform/etc.) on this property -
         this project needs none of them, real or stand-in. Matches Compono.NUnit.Tests'/
         Compono.NUnit.SampleTests' own opt-out. -->
    <ComponoTestFramework>NUnit</ComponoTestFramework>
    <!-- Overrides test/Directory.Build.props' multi-TFM sweep (net8.0;net9.0;net10.0;net11.0) - this
         is a one-shot AOT publish-and-run proof, not a matrix run; a single current TFM is enough. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The repo's central Directory.Packages.props doesn't (and shouldn't) know about the
         throwaway "1.0.0" version pack-compono.sh stamps onto its local-feed-only nupkgs - opting
         this one project out of CPM instead of adding a fake pin to the shared file. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Isolates this restore from NuGet's shared global packages folder entirely - see
         pack-compono.sh's own comment for why. Mirrors Compono.MSTest.AotSmokeTest's own
         isolation. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/.nuget-packages/</RestorePackagesPath>
  </PropertyGroup>

  <!-- PackageReference, not a ProjectReference to src/Compono*/*.csproj - the same consumption shape
       any real consumer uses, and required here specifically: a ProjectReference's global properties
       (PublishAot/RuntimeIdentifier/SelfContained) flow down into Compono.csproj's own analyzer-only
       ProjectReference to Compono.Generators.csproj (netstandard2.0), failing
       `dotnet publish -p:PublishAot=true` with NETSDK1207 for a project that's never actually part
       of the published app. Packed into ../../.local-nuget-feed-nunit-aot-smoke by pack-compono.sh
       (run before publish, not an MSBuild pre-restore target - this project's publish is a
       deliberate, manual, one-shot proof, not part of the ordinary inner-loop restore). -->
  <ItemGroup>
    <PackageReference Include="Compono.NUnit" Version="1.0.0" />
    <!-- BuildFrom's own IMethodInfo parameter needs a real NUnit.Framework.Internal.MethodWrapper -
         a plain PackageReference to NUnit itself (pinned to the current stable version within the
         supported [3.14.0, 5.0.0) range, ADR-0059 §3) so this harness constructs one directly,
         exactly like Compono.NUnit.Tests' own MethodInfoWrapper helper. -->
    <PackageReference Include="NUnit" Version="4.6.1" />
  </ItemGroup>

</Project>
