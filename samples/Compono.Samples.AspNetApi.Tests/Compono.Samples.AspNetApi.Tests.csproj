<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Compono.Samples.AspNetApi.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft Testing Platform (MTP) runner, not VSTest - matches every other test/sample host
         in this repo (see test/Compono.XunitV3.SampleTests/Compono.XunitV3.SampleTests.csproj). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- PLAN-0048's real-project coexistence proof: this project's own namespace already nests
         under Compono (the exact shape that broke when the new matcher type was still named
         Compono.Arg) and already references Compono.NSubstitute directly - adding
         Compono.TestDoubles here, in the same project, is the regression test for "Compono.Match
         and NSubstitute.Arg coexist with no aliasing required for either", not a synthetic example
         in isolation. -->
    <ComponoGeneratedTestDoubles>true</ComponoGeneratedTestDoubles>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!-- ProjectReference to Compono/Compono.XunitV3/Compono.NSubstitute/Compono.Bogus source and to
       the API app under test, matching every other test project in this repo (e.g.
       test/Compono.XunitV3.Tests). Compono.Generators itself is referenced separately, Analyzer-only,
       exactly like Compono.csproj references it for its own compilation
       (docs/adr/0003-generator-package-distribution.md) - a plain ProjectReference chain doesn't
       flow an upstream project's own Analyzer-only ProjectReference transitively (only a packed
       .nupkg's analyzers/dotnet/cs folder does that), so without this the generator would never run
       against this sample's own composed types. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Compono.Samples.AspNetApi/Compono.Samples.AspNetApi.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono/Compono.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.XunitV3/Compono.XunitV3.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.NSubstitute/Compono.NSubstitute.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.Bogus/Compono.Bogus.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.TestDoubles/Compono.TestDoubles.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.Generators/Compono.Generators.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ComponoGeneratedTestDoubles (ADR-0043) is only automatically CompilerVisibleProperty for a
       PackageReference consumer, via Compono's own packaged build/Compono.props - this project's
       ProjectReference above bypasses packaged build assets entirely, so it must declare the same
       visibility itself. Matches benchmarks/Compono.Benchmarks/Compono.Benchmarks.csproj's own
       identical fix for the identical ProjectReference situation. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ComponoGeneratedTestDoubles" />
  </ItemGroup>

</Project>
