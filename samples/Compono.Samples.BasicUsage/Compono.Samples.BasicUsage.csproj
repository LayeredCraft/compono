<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Compono.Samples.BasicUsage</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft Testing Platform (MTP) runner, not VSTest - matches every other test/sample host
         in this repo (see test/Compono.XunitV3.SampleTests/Compono.XunitV3.SampleTests.csproj). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <LocalFeedPath>$(MSBuildThisFileDirectory)../../.local-nuget-feed</LocalFeedPath>
    <Compono_LocalPackagesId Condition="'$(Compono_LocalPackagesId)' == ''">manual</Compono_LocalPackagesId>
    <RestorePackagesPath Condition="'$(UsePackedPackages)' == 'true'">$(MSBuildThisFileDirectory)obj/.nuget-packages/$(Compono_LocalPackagesId)/</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <!-- Dev inner loop (default, per ADR-0033's chosen build story): ProjectReference to Compono/
       Compono.XunitV3 source, fast iteration without a local-feed round-trip. Compono.Generators
       itself is referenced separately, Analyzer-only, exactly like Compono.csproj references it for
       its own compilation (docs/adr/0003-generator-package-distribution.md) - a plain
       ProjectReference chain doesn't flow an upstream project's own Analyzer-only ProjectReference
       transitively (only a packed .nupkg's analyzers/dotnet/cs folder does that), so without this the
       generator would never run against this sample's own composed types in dev mode. -->
  <ItemGroup Condition="'$(UsePackedPackages)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono/Compono.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.XunitV3/Compono.XunitV3.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Compono.Generators/Compono.Generators.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Acceptance verification (dotnet test -p:UsePackedPackages=true): restores the real packed
       .nupkgs from the local feed instead of source, proving this sample builds against what an
       external consumer actually installs - ADR-0033's "packed-package verification for
       acceptance" half of its chosen build story. -->
  <ItemGroup Condition="'$(UsePackedPackages)' == 'true'">
    <PackageReference Include="Compono.XunitV3" />
  </ItemGroup>

  <!-- Only packs/restores from the local feed in packed-verification mode - reuses
       Compono.XunitV3.SampleTests' own pack-to-local-feed.sh rather than a second copy of the same
       script, per ADR-0033's "reused here, not reinvented" build-story rationale. -->
  <Target Name="PackToLocalFeed" BeforeTargets="Restore" Condition="'$(UsePackedPackages)' == 'true'">
    <MakeDir Directories="$(LocalFeedPath)" Condition="!Exists('$(LocalFeedPath)')" />
    <Exec Command="&quot;$(MSBuildThisFileDirectory)../../test/Compono.XunitV3.SampleTests/pack-to-local-feed.sh&quot; &quot;$(MSBuildThisFileDirectory)../../src/Compono/Compono.csproj&quot; &quot;$(MSBuildThisFileDirectory)../../src/Compono.XunitV3/Compono.XunitV3.csproj&quot; &quot;$(MSBuildThisFileDirectory)../../src/Compono.NSubstitute/Compono.NSubstitute.csproj&quot; &quot;$(MSBuildThisFileDirectory)../../src/Compono.Bogus/Compono.Bogus.csproj&quot; &quot;$(LocalFeedPath)&quot; $(Configuration) &quot;$(RestorePackagesPath)&quot;" />
  </Target>

</Project>
